# 在下方填入至少一个 API Key（复制本文件为 .env.local 后填写，重启服务生效）
# 只有填写了 Key 的模型才会出现在页面的模型下拉框中

# ---------- 访问保护（内网/生产部署建议必填） ----------
# 填写后所有页面和 /api 都需要先在 /login 输入此令牌；Cookie 只以 HttpOnly 方式保存。
# 建议使用至少 32 个随机字符，例如：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DO_VEDIO_ACCESS_TOKEN=
# 生产模式默认只监听本机；明确设为 0.0.0.0 才暴露给局域网（必须同时配置上面的令牌）。
DO_VEDIO_HOST=127.0.0.1

# DeepSeek  https://platform.deepseek.com
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# 通义千问（阿里云百炼）https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=
# QWEN_MODEL=qwen-plus

# Kimi（月之暗面）https://platform.moonshot.cn
MOONSHOT_API_KEY=
# KIMI_MODEL=kimi-latest

# 豆包（火山方舟）https://console.volcengine.com/ark  —— 模型名填方舟中的模型 ID 或接入点 ID
ARK_API_KEY=
# DOUBAO_MODEL=doubao-seed-1-6-250615

# OpenAI
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=https://api.openai.com/v1

# Claude（Anthropic）
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_BASE_URL=

# 任意服务商的接口地址都可以用 <ID>_BASE_URL 覆盖，例如 DEEPSEEK_BASE_URL、QWEN_BASE_URL

# 自定义服务商 Key 的服务端加密密钥（建议使用 `openssl rand -hex 32` 生成）
PROVIDER_ENCRYPTION_KEY=

# ---------- 图片 / 视频生成（Replicate，可选） ----------
# Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# 填 Replicate 上具体模型的 version ID；图片和视频分别配置
# REPLICATE_IMAGE_MODEL=
# REPLICATE_VIDEO_MODEL=
# REPLICATE_BASE_URL=https://api.replicate.com/v1

# ---------- 视频制作（均为可选） ----------
# 配音使用上面的 DASHSCOPE_API_KEY（阿里云百炼 CosyVoice）
# DASHSCOPE_TTS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
# 阶段 0 TTS 能力探测：Qwen-Audio-TTS / CosyVoice 非实时接口需要北京 Workspace ID。
# 也可以直接填写完整的 SpeechSynthesizer 地址，优先级高于 DASHSCOPE_WORKSPACE_ID。
# DASHSCOPE_WORKSPACE_ID=
# DASHSCOPE_TTS_HTTP_URL=https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
# Qwen-Audio 生产模型需要配置上方的 Workspace ID 或完整 HTTP 地址；未配置时会在音色设置中禁用。
# Qwen-TTS（qwen3-tts-instruct-flash）使用 DashScope 多模态生成端点；一般无需单独配置。
# DASHSCOPE_QWEN_TTS_HTTP_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
# ---------- Google Gemini TTS（Phase 0/1 探针，默认关闭） ----------
# API Key 只在 Next.js 服务端和 Worker 读取，不要放到浏览器配置。
GOOGLE_GEMINI_API_KEY=
# 已有通用 Gemini Key 也可使用 GEMINI_API_KEY 作为兼容别名。
# GOOGLE_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# GOOGLE_GEMINI_API_VERSION=v1beta
# GOOGLE_GEMINI_TTS_FLASH_MODEL=gemini-3.8-flash-tts
# GOOGLE_GEMINI_TTS_FLASH_LITE_MODEL=gemini-3.8-flash-lite-tts
# 设为 true 后才允许适配器请求上游；探针可通过显式参数启用。
GOOGLE_GEMINI_TTS_ENABLED=false
# GOOGLE_GEMINI_TTS_MAX_TEXT_CHARS=10000
# 国内网络直连 Google 会报「User location is not supported」：填本机代理地址，只有 Gemini 请求走代理，
# DashScope 等国内服务继续直连。Node 不读 Windows 系统代理，需要在这里显式配置。
# GOOGLE_GEMINI_PROXY_URL=http://127.0.0.1:7890
# 阶段 0 可选音色覆盖：
# TTS_PROBE_COSYVOICE_VOICE=longanyang
# TTS_PROBE_QWEN_AUDIO_VOICE=longanhuan_v3.6
# TTS_PROBE_QWEN_TTS_VOICE=Cherry
# 数据目录（数据库、媒体文件、打包缓存），默认 ./data
# DATA_DIR=
# 曲库目录（音频 + library.json），默认 ./bgm
# MUSIC_DIR=
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# 渲染并发（Chrome 标签页数），默认自动
# RENDER_CONCURRENCY=
# 各步骤并发上限，例如 WORKER_CONCURRENCY_TTS=3
# Remotion 公司授权（团队 4 人及以上需要，见 remotion.pro/license）
# REMOTION_LICENSE_KEY=
