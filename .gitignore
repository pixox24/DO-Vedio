# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 自定义风格模板
/data/
!.env.local.example

# 曲库音频不进仓库。把音频放进 bgm/，启动后自动扫描。
/bgm/*
!/bgm/.gitkeep

# 后台运行日志（启动.bat / scripts/start.mjs 产出）
/logs/

# 临时评测产物（动画探针截图、样片等，不进仓库）
/tmp/

# 文字排版参考素材（仅本地参考，不进仓库）
/文字排版参考案例/

# Playwright MCP 调试产物（控制台日志、页面快照，不进仓库）
/.playwright-mcp/

# 本地视频素材库（用户自备媒体，不进仓库；素材管线本轮只接 Pexels）
/Video-asset-library/

# 项目级 AI 工作数据（本地记忆与任务状态，不进仓库）
/.workbuddy-ai/
